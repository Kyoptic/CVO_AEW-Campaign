		class Item126
		{
			dataType="Comment";
			class PositionInfo
			{
				position[]={4831.688,53.681,3008.2209};
			};
			title="Info";
			description="Your platoon has been ambushed in one of the most remote areas of Sefrou Ramal. After a fierce firefight, and with the evening approaching, the insurgent forces in the area have agreed to a temporary cease fire, which will expire at dawn, tomorrow. They will respect the presence of the Red Crystal, but warn that if any of us try to escape the area they will be fired upon. As far as we can tell, we are out of radio range of any other friendly units. The situation is dire." \n "" \n "We cannot surrender to these insurgents, so we must reach Comms Delta, reacquire comms with friendly units, and find ourselves an extraction. A token force will remain here with the medics and the wounded, to ensure the insurgents do not take them captive immediately, but they will be forced to surrender at dawn.";
			id=245;
			atlOffset=-0.00026702881;
		};
