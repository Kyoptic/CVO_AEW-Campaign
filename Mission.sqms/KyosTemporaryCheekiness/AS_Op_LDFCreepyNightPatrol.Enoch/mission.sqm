					property="ace_intelitems_data";
					expression="[_this, _value] call ace_intelitems_fnc_setObjectData";
					class Value
					{
						class data
						{
							singleType="STRING";
							value="1800H: Patrol begins.  Officers T. Zimniak & M.Brodzki." \n "1847H: Issue with oil gauge. Resolved with good thump to dashboard." \n "1902H: Radio not working?? Making checks." \n "1911H: Radio still not working. Stopping vehicle so Officer Zimniak can also take a look." \n "1915H: Everything seems OK on radio, but still not able to Tx or Rx. " \n "1928H: Radio working again! Suddenly static stopped and it started up again. Confirmed check with base station. All OK." \n "2047H: After routine stop, noticed strange movement of trees. Seems someone is cutting some down ??? We move to investigate possible illegal logging activity." \n "2110H: Arriving at intersection. Seems blocked off by some fresh cut logs. We will cut road and remove blockage. Zimniak dismounting to investigate.";
						};
					};
				};
				nAttributes=1;
			};
		};
